# ==============================================================================
# NERA 2.0 - Environment Configuration Template
# All secrets and external provider keys must be configured here.
# DO NOT commit real keys to version control.
# ==============================================================================

# Application & Security
API_BASE_URL=http://localhost:8000
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=*

# Database Configuration
# Default uses local SQLite if PostgreSQL is not running.
# For production PostgreSQL + PostGIS, provide the connection string:
# e.g.: postgresql://username:password@localhost:5432/nera_postgis
DATABASE_URL=sqlite:///./nera.db

# AI & LLM Services (Optional)
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Firebase Authentication & Web Client Configuration (Frontend & Backend)
# Frontend reads VITE_* variables if built with Vite, or via /api/auth/firebase-config
VITE_FIREBASE_API_KEY=your_firebase_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_placeholder
VITE_FIREBASE_APP_ID=your_firebase_app_id_placeholder
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_placeholder

# Optional backend aliases (if not using VITE_ prefix):
FIREBASE_API_KEY=your_firebase_api_key_placeholder
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
FIREBASE_APP_ID=your_firebase_app_id_placeholder

# Push Notifications (Firebase Admin SDK & FCM - Backend Only)
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_placeholder
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_placeholder\n-----END PRIVATE KEY-----"
FCM_SERVER_KEY=your_fcm_server_key_placeholder

# Emergency SMS Gateway Provider
SMS_PROVIDER_API_KEY=your_sms_provider_api_key_placeholder
SMS_PROVIDER_SENDER_ID=NERA_ALERT

# Authoritative Weather & Earth Observation
RAINFALL_API_KEY=your_rainfall_api_key_placeholder
WEATHER_API_KEY=your_weather_api_key_placeholder

# ISRO Bhoonidhi / NISAR Configuration
NISAR_BHOONIDHI_API_KEY=your_bhoonidhi_api_key_placeholder
NISAR_BHOONIDHI_ENDPOINT=https://bhoonidhi.nrsc.gov.in/api/v1

